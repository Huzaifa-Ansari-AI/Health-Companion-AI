# Frontend Client Configuration (Vite Public Environment Variables)
# These variables are safe to be bundled into the client application.
# Replace with your actual Supabase project credentials.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# NOTE: Never put secret keys (e.g., SUPABASE_SERVICE_ROLE_KEY or AI Provider API keys)
# in this file or any client-side .env file.
# AI and elevated backend operations are processed securely via Supabase Edge Functions.

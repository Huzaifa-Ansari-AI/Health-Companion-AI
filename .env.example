# ==============================================================================
# Afiyat AI — Frontend Client Environment Variables Template
# ==============================================================================
# These variables are bundled safely into the client Single Page Application.
# 
# Local Development:
#   Copy this file to .env in the repository root:
#   cp .env.example .env
#
# Vercel Deployment (Production & Preview):
#   Add these variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# Supabase Client Connectivity (Required for Auth, History & Data Storage)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Canonical URL (Optional in dev, Recommended for Production SEO)
# e.g. https://afiyat-ai.vercel.app or https://afiyatai.com
VITE_APP_URL=https://afiyat-ai.vercel.app

# Sentry Error Monitoring DSN (Optional in dev, Recommended for Production)
# Obtain from your Sentry project settings (Platform: React)
# VITE_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0

# ==============================================================================
# SECURITY NOTICE:
# NEVER put secret keys (e.g., SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY)
# in this file or any client-side .env file.
# AI Provider keys and Service-Role keys must only be stored in Supabase Secrets.
# ==============================================================================
